# Copy to .env and fill in. Never commit .env.
# Local inference server (OpenAI-compatible: oMLX, Ollama with OpenAI API,
# LM Studio, vLLM). Used for session distillation.
LLM_BASE_URL=http://127.0.0.1:8000
LLM_API_KEY=

# Distill model id, exactly as the server's /v1/models reports it.
# Needs solid instruction-following; reasoning models must accept
# chat_template_kwargs.enable_thinking=false (see wiki: Thinking-preamble).
DISTILL_MODEL=Qwen3.6-35B-A3B-Uncensored-Heretic-MLX-4bit

# Cognee API (host port; container listens on 8000 internally).
COGNEE_API_URL=http://localhost:8010
COGNEE_DATASET=knowledge_base
